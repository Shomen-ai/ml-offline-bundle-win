# Скопируйте в .env и заполните под свою машину

# Oracle 11g (thick-режим через Instant Client 19.x)
ORACLE_USER=APP_USER
ORACLE_PASSWORD=changeme
ORACLE_DSN=10.0.0.5:1521/ORCLPDB
ORACLE_CLIENT_DIR=D:\oracle\instantclient_19_31

# Отдельный сервер с нейронкой
LLM_URL=http://127.0.0.1:8001

# Active Directory. Закомментировано = вход по локальному паролю с регистрацией.
# Раскомментируйте, чтобы пускать по доменным учёткам (пароли в БД не хранятся).
# Требует пакет ldap3 — в базовый офлайн-бандл он не входит, см. README.
#LDAP_URL=ldap://dc.example.local:389
#LDAP_DOMAIN=example.local
#LDAP_BASE_DN=DC=example,DC=local
#LDAP_USER_ATTR=sAMAccountName
#LDAP_TIMEOUT=10

# Время жизни сессии, часов
TOKEN_TTL_HOURS=72
